{
  "name": "bullbearscope-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "openapi-typescript ${API_SCHEMA_URL:-http://localhost:8000/openapi.json} -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
