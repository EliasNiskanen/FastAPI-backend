# Copy to .env and fill in. Never commit .env.
ALPHAVANTAGE_API_KEY=your-key-here

# Local Postgres (docker compose overrides this for the api container)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stocks

# Minutes before stored data is considered stale and refetched
CACHE_TTL_MINUTES=180
CRYPTO_CACHE_TTL_MINUTES=5
# Stock gainers/losers and the stock symbol list (search) cost Alpha Vantage requests
STOCK_MOVERS_TTL_MINUTES=360
STOCK_LISTING_TTL_MINUTES=10080

# Crypto comes from Binance public market data (free, no key needed)
# Default quote currency when the request has no ?quote=
DEFAULT_CRYPTO_QUOTE=USDT

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Optional: protects POST /api/ingest/* (header X-Ingest-Token)
INGEST_TOKEN=

LOG_LEVEL=INFO
