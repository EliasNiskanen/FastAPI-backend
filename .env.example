# Copy to .env and fill in. Never commit .env.
ALPHAVANTAGE_API_KEY=your-key-here

# Local Postgres (docker compose overrides this for the api container)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stocks

# Minutes before stored data is considered stale and refetched
CACHE_TTL_MINUTES=60

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Optional: protects POST /api/ingest/* (header X-Ingest-Token)
INGEST_TOKEN=

LOG_LEVEL=INFO
